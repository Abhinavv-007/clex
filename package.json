{
  "name": "clex-all-in-one",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess",
      "workerd",
      "sharp",
      "better-sqlite3"
    ],
    "overrides": {
      "@xmldom/xmldom": "0.8.15",
      "protobufjs": "^7.5.5",
      "websocket-driver": ">=0.7.5",
      "brace-expansion": ">=1.1.18",
      "browserslist": ">=4.28.7",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "undici": ">=6.27.0",
      "ws": ">=8.21.0",
      "@grpc/grpc-js": ">=1.9.16"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream --filter @clex/signaling --filter @clex/api --filter @clex/chain --filter @clex/frontend dev",
    "dev:web": "pnpm --filter @clex/frontend dev",
    "dev:signal": "pnpm --filter @clex/signaling dev",
    "dev:frontend": "pnpm --filter @clex/frontend dev",
    "dev:api": "pnpm --filter @clex/api dev",
    "dev:chain": "pnpm --filter @clex/chain dev",
    "build": "pnpm --filter @clex/frontend-core build && pnpm --filter @clex/signaling build && pnpm --filter @clex/api build && pnpm --filter @clex/chain build && pnpm --filter @clex/frontend build",
    "preview": "pnpm --filter @clex/frontend preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm --filter @clex/cli test",
    "test:web": "vitest run",
    "test:cli": "pnpm --filter @clex/cli test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
