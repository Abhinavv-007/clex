# ─── Signaling (apps/signaling) ─────────────────────────────────────────────
# Set in wrangler.toml [vars] — not a real .env file for Workers
# ALLOWED_ORIGIN=http://localhost:5173

# ─── Web app (apps/web/.env) ─────────────────────────────────────────────────

# Public — safe to expose in browser builds
PUBLIC_SIGNALING_URL=ws://localhost:8787
PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Server-side only (never exposed to browser)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Production
# PUBLIC_SIGNALING_URL=wss://signal.clex.in
# GOOGLE_REDIRECT_URI=https://clex.in/api/auth/google/callback
