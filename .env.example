# ─── Frontend (copy into frontend-2/.env.local) ─────────────────────────────
# Public — safe to expose in browser builds
PUBLIC_SIGNALING_URL=ws://localhost:8787
PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
PUBLIC_API_BASE_URL=http://localhost:8788
PUBLIC_CHAIN_URL=http://localhost:8789

# Production same-origin example
# PUBLIC_SIGNALING_URL=wss://signal.clex.in
# PUBLIC_API_BASE_URL=
# PUBLIC_CHAIN_URL=

# ─── API Worker (apps/api/wrangler.toml [vars]) ─────────────────────────────
# Set in wrangler.toml [vars] for local and production environments
# ALLOWED_ORIGIN=http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
# Production
# FRONTEND_BASE_URL=https://clex.in
# GOOGLE_REDIRECT_URI=https://clex.in/api/auth/google/callback
