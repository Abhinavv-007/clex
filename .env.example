# ─── Frontend (copy into apps/web/.env.local) ─────────────────────────────
# Public — safe to expose in browser builds
PUBLIC_SIGNALING_URL=ws://localhost:8787
PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
PUBLIC_API_BASE_URL=http://localhost:8788
PUBLIC_CHAIN_URL=http://localhost:8789

# Production same-origin example
# PUBLIC_SIGNALING_URL=wss://signal.clex.in
# PUBLIC_API_BASE_URL=
# PUBLIC_CHAIN_URL=

# ─── API Worker (apps/api/wrangler.toml [vars]) ─────────────────────────────
# Set in wrangler.toml [vars] for local and production environments
# ALLOWED_ORIGIN=http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:3000
# The admin console password is a worker secret (never a var):
#   cd apps/api && wrangler secret put CLEX_ADMIN_SECRET --env production
# For local dev put it in apps/api/.dev.vars:
#   CLEX_ADMIN_SECRET=<a long random string>
