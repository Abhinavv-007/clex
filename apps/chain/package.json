{
  "name": "@clex/chain",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts --ip 0.0.0.0 --port 8789 --inspector-port 9239",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply clex-chain --local",
    "db:migrate:remote": "wrangler d1 migrations apply clex-chain --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240529.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.60.3"
  }
}
